# Server & App Configuration
PORT=3000
APP_URL="http://localhost:3000"

# MongoDB Database Connection
# If left empty or omitted, an embedded in-memory MongoDB server starts automatically.
# For production or persistent external MongoDB, specify a real URI:
# MONGODB_URI="mongodb://localhost:27017/online_bookstore"
# or MongoDB Atlas:
# MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/online_bookstore?retryWrites=true&w=majority"
MONGODB_URI=""

# JWT Authentication Secret — REQUIRED in production. Use a long random string.
# Example: openssl rand -hex 64
JWT_SECRET=""

# Optional Gemini API Key (not currently used by any feature)
GEMINI_API_KEY=""
